# ============================================================
# LifeOS Smart Campus — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit real credentials to version control.
# ============================================================

# --- Security ---
# Change this in production!
SECRET_KEY=change-me-in-production
EMBEDDING_ENCRYPT_KEY=change-me-in-production

# --- Database ---
# Defaults to SQLite: sqlite:///<backend>/data/lifeos.db
# DATABASE_URL=sqlite:///./data/lifeos.db

# --- Face Recognition ---
FACE_MATCH_THRESHOLD=0.52

# --- Email (SMTP) — Gmail example ---
# Email is optional. Attendance is still saved even if email fails.
# Enable email sending:
EMAIL_ENABLED=false

# SMTP host / port (Gmail: smtp.gmail.com, 587 TLS or 465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail address used to send (also the login username).
# Use a Gmail App Password, NOT your normal Gmail password:
#   https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=

# From address shown on emails (defaults to SMTP_USERNAME if empty)
SMTP_FROM_EMAIL=

# Use TLS on connect (true for port 587)
SMTP_USE_TLS=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (optional) ---
RATE_LIMIT_ENABLED=false
