# ===== LifeOS Smart Campus — Backend Environment =====
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-secret
EMBEDDING_ENCRYPT_KEY=change-me-to-a-random-encryption-key

# --- Database ---
# Default: SQLite at backend/data/lifeos.db
DATABASE_URL=sqlite:///./data/lifeos.db

# --- Face Recognition ---
# Similarity threshold (0-1). Higher = stricter match.
FACE_MATCH_THRESHOLD=0.52

# --- Email (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true

# Set to true to enable email sending
EMAIL_ENABLED=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false