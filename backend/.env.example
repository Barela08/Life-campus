# ============================================================
# Life Campus — Backend Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in REAL values.
# NEVER commit real credentials. This file contains placeholders only.
# ============================================================

# --- Security ---
# Change in production! A long random string.
SECRET_KEY=change-this-to-a-long-random-secret-key
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Defaults to SQLite at backend/data/lifeos.db if unset.
# DATABASE_URL=sqlite:///./data/lifeos.db

# --- Face Recognition ---
# Match similarity threshold 0-1 (higher = stricter match)
FACE_MATCH_THRESHOLD=0.52
# Key used to obfuscate stored face embeddings
EMBEDDING_ENCRYPT_KEY=change-this-to-a-long-random-key

# --- Email / SMTP (Gmail-compatible) ---
# Set EMAIL_ENABLED=true to ACTIVATE sending.
# For Gmail use an App Password (NOT your normal account password):
#   https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Full Gmail address, e.g. yourname@gmail.com
SMTP_USERNAME=
# Gmail App Password (16 chars, no spaces)
SMTP_PASSWORD=
# From address; leave blank to use SMTP_USERNAME
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Rate limiting (optional) ---
RATE_LIMIT_ENABLED=false
